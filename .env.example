SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SENDER_EMAIL=sender@example.com
DEFAULT_RECEIVER_EMAIL=receiver@example.com
ENABLE_EMAIL_NOTIFICATIONS=True

# Instruções:
# 1. Copie este arquivo para .env (ex: cp .env.example .env)
# 2. Preencha as variáveis em .env com suas credenciais SMTP reais.
# 3. O arquivo .env é ignorado pelo Git (verifique .gitignore) e não deve ser commitado.
